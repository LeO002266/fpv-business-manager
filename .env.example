# FPV Business Manager Environment Variables

PORT=5000
NODE_ENV=development
JWT_SECRET=fpv-jwt-secret-key-super-secure-2026

# PostgreSQL Database Configuration:
# To connect to PostgreSQL (Local, Supabase, Neon, Railway, or AWS RDS):
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/fpv_business_manager
#
# If DATABASE_URL is not set, the app will run with local SQLite database in /data/fpv_manager.db
DATABASE_URL=
